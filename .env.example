# Copy this file to `.env` at the root of the project, adjust the paths and export it in your shell.
# The variables are read from the environment by `torch_pointcloud.config`, which the example scripts use
# for their defaults.
#
# Where datasets are downloaded and processed (default: ./data).
TORCH_POINTCLOUD_DATA_DIR=...
# Root of the cache directory (default: ~/.cache/torch-pointcloud), where models weights are downloaded.
#TORCH_POINTCLOUD_CACHE_DIR=...
# Whether farthest point sampling starts from a random point (default: unset).
#TORCH_POINTCLOUD_FPS_RANDOM_START=true
