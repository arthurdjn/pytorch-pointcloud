# Copy this file to `.env` at the root of the project, adjust the paths and export it in your shell.
# The variables are read from the environment by `torch_pointcloud.config`, which the example scripts use
# for their defaults.
#
# Where datasets are downloaded and processed (default: ./data).
TORCH_POINTCLOUD_DATA_DIR=...
# Where pretrained weights are cached, one `<checkpoint>/model.safetensors` per registered checkpoint
# (default: ~/.cache/torch-pointcloud/models).
TORCH_POINTCLOUD_MODELS_DIR=...
# Root of the cache directory (default: ~/.cache/torch-pointcloud).
#TORCH_POINTCLOUD_CACHE_DIR=...
# Global seed for random operations (default: unset, no seeding).
#TORCH_POINTCLOUD_RANDOM_SEED=42
# Whether farthest point sampling starts from a random point (default: unset).
#TORCH_POINTCLOUD_FPS_RANDOM_START=true
# Distance-matrix budget above which the dense knn fast path falls back to torch_cluster (default: 16000000).
#TORCH_POINTCLOUD_KNN_DENSE_BUDGET=16000000
